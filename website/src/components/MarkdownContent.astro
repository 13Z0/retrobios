---
// Search weight: Pagefind multiplies the score of words inside a weighted
// element, so a Start here page outranks the reference page that names it,
// and an emulator outranks its launcher or its frozen copy.
import Default from '@astrojs/starlight/components/MarkdownContent.astro';

const { searchWeight } = Astro.locals.starlightRoute.entry.data;
---

{
	searchWeight ? (
		<div data-pagefind-weight={String(searchWeight)}>
			<Default><slot /></Default>
		</div>
	) : (
		<Default><slot /></Default>
	)
}

<script>
	import '../scripts/site.ts';
</script>

<!-- Global: the lookup form on files/ is written by the generator. Its input
     keeps to the column on a phone (size="66" made it 707 px wide). -->
<style is:global>
	.sl-markdown-content .rb-file-lookup input {
		width: 100%;
		min-width: 0;
		max-width: 40rem;
		box-sizing: border-box;
	}
</style>
